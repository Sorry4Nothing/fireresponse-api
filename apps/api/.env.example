# Vorlage für apps/api/.env, nur für die Entwicklung; npm run dev -w apps/api und npm run db:migrieren -w apps/api lesen die Datei
# PostgreSQL aus docker-compose.yml, ohne Passwort
# Rolle der API: liest und schreibt Daten, ändert aber nichts am Schema
DATABASE_URL=postgres://fireresponse_api@localhost:5432/fireresponse
# Besitzer der Tabellen, nur für die Migrationen
MIGRATION_DATABASE_URL=postgres://fireresponse_besitzer@localhost:5432/fireresponse
# Älteste App-Version, die die API annimmt; ältere bekommen 426
APP_MIN_VERSION=0.1.0
PORT=3000
# Geheimnis von better-auth für Sitzungen und die TOTP-Verschlüsselung, mindestens 32 Zeichen; Erzeugung steht im README
BETTER_AUTH_SECRET=
# Basis-URL der API; mit https setzt better-auth Secure-Cookies
BETTER_AUTH_URL=http://localhost:3000
# Freiwillig: Tage vor dem Termin, ab denen sich anmelden lässt (Standard 42)
# ANMELDEFENSTER_TAGE=42
# Freiwillig: verantwortliche Stelle und ihre E-Mail-Adresse für /datenschutz, /konto-loeschen und /support; nur erfundene Werte (example.org)
# VERANTWORTLICHE_STELLE=Verein Beispiel
# KONTAKT_EMAIL=kontakt@example.org
# Freiwillig: Pfad zur JSON-Schlüsseldatei des Firebase-Dienstkontos für Pushes über FCM; ohne sie sendet die API keine Pushes. Die Datei bleibt ausserhalb des Repos
# FCM_SCHLUESSEL_DATEI=
# Freiwillig: Hosts, von denen die API Lodur-Kalender abruft, kommagetrennt, nur Hostnamen; ohne sie nimmt die API keinen Lodur-Link an und synchronisiert nichts. Nur erfundene Werte (example.org)
# LODUR_ERLAUBTE_HOSTS=kalender.example.org
